# ─── Higher or Lower — Environment Variables ────────────────────────────────
#
# Copy this file to:
#
#   .env.local
#
# Then replace the placeholder values with your real credentials.
#
# IMPORTANT:
# - .env.local must remain git-ignored.
# - Never commit real API keys or secrets.
# - Do NOT add the NEXT_PUBLIC_ prefix to these variables.
# - These credentials are used only by server-side code.
#
# ─────────────────────────────────────────────────────────────────────────────


# ─── TMDB ───────────────────────────────────────────────────────────────────
#
# Used for:
# - Movie & Series Rating
# - Release Date
# - Gross Revenue
#
# Create/manage credentials at:
# https://www.themoviedb.org/settings/api
#
TMDB_API_KEY=your_tmdb_api_key_here


# ─── YouTube Data API v3 ────────────────────────────────────────────────────
#
# Used for:
# - YouTube Subscribers
#
# Requires:
# - YouTube Data API v3 enabled in Google Cloud
# - API key restricted to YouTube Data API v3
#
# Manage credentials at:
# https://console.cloud.google.com/apis/credentials
#
YOUTUBE_API_KEY=your_youtube_api_key_here


# ─── Twitch / IGDB ──────────────────────────────────────────────────────────
#
# Used for:
# - Game Release Date
#
# IGDB uses Twitch OAuth client-credentials authentication.
#
# Requires:
# - Twitch Developer application
# - Client ID
# - Client Secret
#
# Manage applications at:
# https://dev.twitch.tv/console/apps
#
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here


# ─── Public APIs — No Credentials Required ──────────────────────────────────
#
# SteamSpy
# - Peak Concurrent Players
# - Game Rating
#
# MusicBrainz
# - Number of Albums
# - Album Release Date
#
# Cover Art Archive
# - Album artwork used by MusicBrainz-backed categories
#
# Other existing public integrations in the repository:
# - World Bank Open Data
# - FlagCDN
#
# No environment variables are required for these providers.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Metrika ─────────────────────────────────────────────────────────────────
#
# Used by:
# - Monthly Listeners snapshot generation
# - Twitch Followers snapshot refresh
#
METRIKA_API_TOKEN=your_metrika_api_token_here