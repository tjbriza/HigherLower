# ─── Higher or Lower — Environment Variables ────────────────────────────────
#
# Copy this file to .env.local and fill in your real keys.
# .env.local is git-ignored and will never be committed.
#
# API keys must NOT have the NEXT_PUBLIC_ prefix — they are used only
# on the server side (Server Components / Route Handlers).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Keys required ───────────────────────────────────────────────────────────

# TMDB (The Movie Database) — used for: Movie Ratings category
# Sign up free at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ─── No keys needed (public APIs) ────────────────────────────────────────────
# SteamSpy top100in2weeks  → Game Playerbase     (steamspy.com/api.php)
# SteamSpy top100forever   → Game Ratings        (steamspy.com/api.php)
# World Bank Open Data     → Country Populations (api.worldbank.org)
# flagcdn.com              → Country flag images (flagcdn.com)
