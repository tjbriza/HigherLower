# ─── Higher or Lower — Environment Variables ────────────────────────────────
#
# Copy this file to .env.local and fill in your real keys.
# .env.local is git-ignored and will never be committed.
#
# API keys must NOT have the NEXT_PUBLIC_ prefix — they are used only
# on the server side (Server Components / Route Handlers).
# ─────────────────────────────────────────────────────────────────────────────

# TMDB (The Movie Database) — Movie Ratings category
# Sign up free at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ─── No keys needed for these categories ────────────────────────────────────
# SteamSpy  (Game Playerbase) — public, no key required
# CheapShark (Game Ratings)   — public, no key required (replaces RAWG)
# FakeStore  (Item Prices)    — public, no key required
